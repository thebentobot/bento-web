{
    "name": "bento-web",
    "author": {
        "name": "Christian Krogh Nielsen",
        "email": "christian@chrkn.dev",
        "url": "https://chrkn.dev"
    },
    "type": "module",
    "version": "0.5.1",
    "engines": {
        "node": ">=24.19.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "test": "vitest run",
        "preview": "astro build && wrangler dev --remote",
        "astro": "astro",
        "deploy": "astro build && wrangler deploy",
        "lint": "eslint . --ignore-pattern worker-configuration.d.ts",
        "lint:fix": "eslint . --fix --ignore-pattern worker-configuration.d.ts",
        "format": "prettier --write .",
        "cf-typegen": "wrangler types",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "CLOUDFLARE_ACCOUNT_ID=$CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN=$CLOUDFLARE_D1_TOKEN wrangler d1 migrations apply bento-web-db --remote",
        "db:execute": "CLOUDFLARE_ACCOUNT_ID=$CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN=$CLOUDFLARE_D1_TOKEN wrangler d1 execute bento-web-db --remote",
        "db:setup": "npm run db:generate && npm run db:migrate",
        "db:migrate:local": "wrangler d1 migrations apply bento-web-db --local",
        "db:execute:local": "wrangler d1 execute bento-web-db --local",
        "db:setup:local": "npm run db:generate && npm run db:migrate:local",
        "deploy:staging": "astro build && wrangler deploy --env staging",
        "deploy:production": "astro build && wrangler deploy --env production",
        "db:migrate:staging": "wrangler d1 migrations apply bento-web-db-staging --remote --env staging",
        "db:execute:staging": "wrangler d1 execute bento-web-db-staging --remote --env staging",
        "prepare": "husky"
    },
    "devDependencies": {
        "@astrojs/cloudflare": "^14.1.7",
        "@astrojs/sitemap": "^3.7.3",
        "@astrojs/svelte": "^9.0.1",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/luxon": "^3.7.3",
        "@types/node": "^25.9.5",
        "@typescript-eslint/parser": "^8.65.0",
        "astro": "^7.1.6",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.1.0",
        "eslint-plugin-svelte": "^3.22.0",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-svelte": "^4.1.1",
        "rollup-plugin-visualizer": "^7.0.1",
        "svelte": "^5.56.8",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10",
        "wrangler": "^4.118.0"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.6.25",
        "@libsql/client": "^0.17.4",
        "@skyra/discord-components-core": "4.0.2",
        "astro-font": "^1.1.0",
        "astro-icon": "^1.1.5",
        "astro-loading-indicator": "^0.9.0",
        "better-auth": "^1.6.25",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "luxon": "^3.7.2",
        "mode-watcher": "^1.1.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "unified": "^11.0.5"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.astro": [
            "eslint --fix",
            "prettier --write --parser astro"
        ],
        "*.svelte": [
            "eslint --fix",
            "prettier --write --parser svelte"
        ],
        "*.{js,cjs,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.css": [
            "prettier --write"
        ]
    }
}
